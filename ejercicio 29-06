create database ligapokemon;
use ligapokemon;

create table ciudad (
    IDciudad int auto_increment primary key,
    nombre varchar(50) not null
);

create table gimnasio (
    IDgimnasio int auto_increment primary key,
    nombre varchar(50) not null,
    IDciudad int,
    IDlider int,
    foreign key (IDciudad) references ciudad(IDciudad),
    foreign key (IDlider) references entrenador(IDentrenador)
);

create table entrenador (
    IDentrenador int auto_increment primary key,
    nombre varchar(50) not null,
    IDciudad int,
    IDgimnasio int,
    foreign key (IDciudad) references ciudad(IDciudad),
    foreign key (IDgimnasio) references gimnasio(IDgimnasio)
);

create table tipo (
    IDtipo int auto_increment primary key,
    nombre varchar(30) not null
);

create table pokemon (
    IDpokemon int auto_increment primary key,
    nombre varchar(50) not null,
    nivel int not null,
    IDtipo int,
    IDentrenador int,
    foreign key (IDtipo) references tipo(IDtipo),
    foreign key (IDentrenador) references entrenador(IDentrenador)
);

create table batalla (
    IDbatalla int auto_increment primary key,
    IDpokemon1 int,
    IDpokemon2 int,
    IDganador int,
    fecha date,
    foreign key (IDpokemon1) references pokemon(IDpokemon),
    foreign key (IDpokemon2) references pokemon(IDpokemon),
    foreign key (IDganador) references pokemon(IDpokemon)
);
select e.nombre as entrenador, c.nombre as ciudad, g.nombre as gimnasio
from entrenador e
join ciudad c on e.IDciudad = c.IDciudad
join gimnasio g on e.IDgimnasio = g.IDgimnasio;

select p.nombre as pokemon, t.nombre as tipo
from pokemon p
join tipo t on p.IDtipo = t.IDtipo;

select nombre, nivel from pokemon where nivel > 50;

select p.nombre as pokemon, p.nivel, e.nombre as entrenador
from pokemon p
join tipo t on p.IDtipo = t.IDtipo
join entrenador e on p.IDentrenador = e.IDentrenador
where t.nombre = 'fuego'
order by p.nivel asc;
select nombre
from pokemon
where IDentrenador in ( select IDentrenador from entrenador
    where IDciudad in ( select IDciudad from ciudad where nombre = 'celadon' )
);

select nombre, nivel
from pokemon
where nivel > (select avg(nivel) from pokemon);

select nombre
from pokemon
where IDpokemon in ( select IDganador from batalla
);
