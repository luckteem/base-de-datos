create database liga_futbol;
use ligafutbol;

create table equipos (
    IDequipo int auto_increment primary key,     nombre varchar(50) not null,
    estadio varchar(50),
    aforo int,
    fundacion int,
    ciudad varchar(50)
);

create table presidentes (
    dni varchar(12) primary key,
    nombre varchar(50) not null,
    apellidos varchar(50) not null,
    fechanacimiento date,
    IDequipo int unique, 
    añoeleccion int,
    foreign key (IDequipo) references equipos(IDequipo) 
);

create table jugadores (
    IDjugador int auto_increment primary key,     nombre varchar(50) not null,
    fechanacimiento date,
    posicion varchar(30), 
    IDequipo int,
    foreign key (IDequipo) references equipos(IDequipo) 
);

create table partidos (
    IDpartido int auto_increment primary key,
    fecha date not null,
    golescasa int default 0,
    golesfuera int default 0
);

create table goles (
    IDgol int auto_increment primary key,
    minuto int not null,
    descripcion text,
    IDpartido int,
    IDjugador int,
    foreign key (IDpartido) references partidos(IDpartido),
    foreign key (IDjugador) references jugadores(IDjugador)
);

